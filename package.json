{
  "name": "pdb-quickview",
  "version": "1.2.0",
  "description": "Searchable mirror of the wwPDB with precomputed PyMol thumbnails, served from SQLite behind nginx.",
  "type": "module",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/pdb.cheminfo.org.git"
  },
  "homepage": "https://github.com/cheminfo/pdb.cheminfo.org#readme",
  "bugs": {
    "url": "https://github.com/cheminfo/pdb.cheminfo.org/issues"
  },
  "keywords": [
    "pdb",
    "pdb-parser",
    "pymol",
    "thumbnails",
    "sqlite"
  ],
  "author": "Daniel Kostro",
  "license": "MIT",
  "scripts": {
    "api": "npm run api -w backend",
    "check-env": "node -e \"if(!require('node:fs').existsSync('.env')){console.error('\\nERROR: .env is required.\\nRun:  cp .env.example .env\\n');process.exit(1)}\"",
    "check-types": "npm run check-types -w frontend",
    "cron": "npm run cron -w backend",
    "cron-ccd": "npm run cron-ccd -w backend",
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:seed": "npm run dev:seed -w backend",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "rebuild": "npm run rebuild -w backend",
    "seed": "npm run seed -w backend",
    "seed-ccd": "npm run seed-ccd -w backend",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "npm run test-only -w backend && npm run test-only -w frontend",
    "update": "npm run update -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-config-zakodium": "^20.1.0",
    "prettier": "^3.9.5"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
