    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "molstar": "^5.11.0",
    "monaco-editor": "^0.55.1",
    "openchemlib": "^9.25.0",
    "react": "^19.2.8",
    "react-cheminfo": "^0.22.0",
    "react-dom": "^19.2.8",
    "react-mf": "^3.1.1",
