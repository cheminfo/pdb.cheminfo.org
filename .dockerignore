!.git/HEAD
!.git/refs
!.git/packed-refs
.github
.claude
.DS_Store
.env
.env.*
!.env.example
compose*.yaml
coverage
data
node_modules
backend/node_modules
backend/coverage
frontend/node_modules
frontend/playwright-report
frontend/test-results
backend/public
*.log
